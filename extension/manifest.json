{
  "manifest_version": 3,
  "name": "AZ_vk_poster",
  "version": "0.9.2",
  "description": "Отложенные посты VK: фото сообщества, музыка исполнителя и текст из документа, цитата по теме или ваш текст.",
  "permissions": [
    "storage",
    "scripting",
    "activeTab",
    "alarms",
    "notifications",
    "downloads",
    "webNavigation"
  ],
  "host_permissions": [
    "https://vk.ru/*",
    "https://vk.com/*",
    "https://docs.google.com/*",
    "https://ru.wikiquote.org/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "AZ_vk_poster"
  }
}
